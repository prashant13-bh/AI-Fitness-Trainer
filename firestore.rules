rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isValidEmail(email) {
      return email.matches('.*@.*\\..*');
    }
    
    // Users collection
    match /users/{userId} {
      // Allow users to read and write their own data
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && 
                      request.resource.data.keys().hasAll(['email', 'createdAt']) &&
                      isValidEmail(request.resource.data.email);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
      
      // User profile pictures subcollection
      match /profilePictures/{pictureId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }
      
      // User fitness goals subcollection
      match /fitnessGoals/{goalId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) &&
                        request.resource.data.keys().hasAll(['goal', 'createdAt']);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // User body measurements subcollection
      match /bodyMeasurements/{measurementId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) &&
                        request.resource.data.keys().hasAll(['date', 'createdAt']);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // User preferences subcollection
      match /preferences/{prefId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Workouts collection
    match /workouts/{workoutId} {
      // Allow users to read and write their own workouts
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'date', 'createdAt']);
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      
      // Workout exercises subcollection
      match /exercises/{exerciseId} {
        allow read: if isAuthenticated() && 
                       get(/databases/$(database)/documents/workouts/$(workoutId)).data.userId == request.auth.uid;
        allow write: if isAuthenticated() && 
                        get(/databases/$(database)/documents/workouts/$(workoutId)).data.userId == request.auth.uid;
      }
      
      // Workout sets subcollection
      match /sets/{setId} {
        allow read: if isAuthenticated() && 
                       get(/databases/$(database)/documents/workouts/$(workoutId)).data.userId == request.auth.uid;
        allow write: if isAuthenticated() && 
                        get(/databases/$(database)/documents/workouts/$(workoutId)).data.userId == request.auth.uid;
      }
    }
    
    // Workout Plans collection
    match /workoutPlans/{planId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'name', 'createdAt']);
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      
      // Plan days subcollection
      match /days/{dayId} {
        allow read: if isAuthenticated() && 
                       get(/databases/$(database)/documents/workoutPlans/$(planId)).data.userId == request.auth.uid;
        allow write: if isAuthenticated() && 
                        get(/databases/$(database)/documents/workoutPlans/$(planId)).data.userId == request.auth.uid;
      }
    }
    
    // Diet Plans collection
    match /dietPlans/{planId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'name', 'createdAt']);
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      
      // Meals subcollection
      match /meals/{mealId} {
        allow read: if isAuthenticated() && 
                       get(/databases/$(database)/documents/dietPlans/$(planId)).data.userId == request.auth.uid;
        allow write: if isAuthenticated() && 
                        get(/databases/$(database)/documents/dietPlans/$(planId)).data.userId == request.auth.uid;
      }
    }
    
    // Progress tracking collection
    match /progress/{progressId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'date', 'createdAt']);
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      
      // Progress photos subcollection
      match /photos/{photoId} {
        allow read: if isAuthenticated() && 
                       get(/databases/$(database)/documents/progress/$(progressId)).data.userId == request.auth.uid;
        allow write: if isAuthenticated() && 
                        get(/databases/$(database)/documents/progress/$(progressId)).data.userId == request.auth.uid;
      }
    }
    
    // AI Analysis results collection
    match /aiAnalysis/{analysisId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'timestamp', 'analysisType']);
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Achievements collection
    match /achievements/{achievementId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Streaks collection (daily activity tracking)
    match /streaks/{streakId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Exercise library (read-only for all authenticated users)
    match /exerciseLibrary/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins can modify (handled via Firebase Admin SDK)
    }
    
    // Deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
